{
  "name": "cheat-on-content-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx server/index.ts",
    "start": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "test": "tsx --test server/*.test.ts",
    "collector:test": "python -m unittest discover -s collector -p test_*.py",
    "extension:test": "node --test browser-extension/test/*.test.mjs",
    "extension:e2e": "python browser-extension/test/e2e_pipeline.py",
    "extension:check": "node --check browser-extension/src/background.js && node --check browser-extension/src/content/main-world.js && node --check browser-extension/src/content/relay.js && node --check browser-extension/src/lib/extract.js && node --check browser-extension/src/popup/popup.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vite": "^6.4.0"
  }
}
