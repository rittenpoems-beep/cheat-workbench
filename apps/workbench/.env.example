# 复制为 .env 后按需填写；不要提交真实 Key。
# 默认通道是本机 CodeBuddy CLI。通常无需配置路径；如需指定：
# WORKBENCH_CODEBUDDY_CLI=D:\path\to\codebuddy
# WORKBENCH_CODEBUDDY_MODEL=auto

# 独立模型 API（也可作为 CodeBuddy 的后端）。
# DEEPSEEK_API_KEY=
# WORKBENCH_MODEL_API_KEY=
# WORKBENCH_MODEL_BASE_URL=https://api.deepseek.com
# WORKBENCH_MODEL=deepseek-flash

# 盲评子 agent 使用的模型；默认 deepseek-flash。
# WORKBENCH_BLIND_MODEL=deepseek-flash

# 允许访问本机/私有网络的 OpenAI 兼容端点（默认拒绝）。
# WORKBENCH_ALLOW_PRIVATE_MODEL_ENDPOINT=1

# WORKBENCH_PROVIDER=codebuddy
# WORKBENCH_PORT=4317
# WORKBENCH_DEMO_PORT=4318
# WORKBENCH_BUDGET=50
